                new VBox(6);

        card
                .getStyleClass()
                .add(
                        "feature-card"
                );

        card.setAlignment(
                Pos.CENTER
        );

        Label icon =
                new Label(
                        iconText
                );

        icon
                .getStyleClass()
                .add(
                        "card-icon"
                );

        Label title =
                new Label(
                        titleText
                );

        title
                .getStyleClass()
                .add(
                        "card-title"
                );

        Label subtitle =
                new Label(
                        subtitleText
                );

        subtitle
                .getStyleClass()
                .add(
