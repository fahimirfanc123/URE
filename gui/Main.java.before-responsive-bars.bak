    }

    /*
     * =========================================================
     * MAGNETIC CURSOR
     * =========================================================
     */

    private void createMagneticCursor(
            Scene scene,
            StackPane root
    ) {

        Circle ring =
                new Circle(
                        9
                );

        ring.setFill(
                Color.TRANSPARENT
        );

        ring.setStroke(
                Color.rgb(
                        233,
                        84,
                        32,
                        0.92
                )
        );

        ring.setStrokeWidth(
                1.25
        );

        Circle dot =
                new Circle(
                        2.4
                );

        dot.setFill(
                Color.web(
                        "#FF7948"
                )
        );

        StackPane cursor =
                new StackPane(
                        ring,
                        dot
                );

        cursor.setManaged(
                false
        );

        cursor.setMouseTransparent(
                true
        );

        ring.setMouseTransparent(
                true
        );

        dot.setMouseTransparent(
                true
        );

        cursor.setVisible(
                false
        );

        root
                .getChildren()
                .add(
                        cursor
                );

        scene.setCursor(
                Cursor.NONE
        );

        scene.addEventFilter(
                MouseEvent.MOUSE_ENTERED,
                event ->
                        cursor.setVisible(
                                true
                        )
        );

        scene.addEventFilter(
                MouseEvent.MOUSE_EXITED,
                event ->
                        cursor.setVisible(
                                false
                        )
        );

        scene.addEventFilter(
                MouseEvent.MOUSE_MOVED,
                event -> {

                    cursor.relocate(

                            event.getSceneX()
                                    - 9,

                            event.getSceneY()
                                    - 9
                    );

                    updateMagneticCursor(
                            event,
                            ring,
                            dot
                    );
                }
        );

        scene.addEventFilter(
                MouseEvent.MOUSE_DRAGGED,
                event -> {

                    cursor.relocate(

                            event.getSceneX()
                                    - 9,

                            event.getSceneY()
                                    - 9
                    );
                }
        );

        scene.addEventFilter(
                MouseEvent.MOUSE_PRESSED,
                event -> {

                    ring.setRadius(
                            6.5
                    );

                    dot.setRadius(
                            3.0
                    );
                }
        );

        scene.addEventFilter(
                MouseEvent.MOUSE_RELEASED,
                event -> {

                    ring.setRadius(
                            9
                    );

                    dot.setRadius(
                            2.4
                    );
                }
        );
    }

    /*
     * =========================================================
     * MAGNETIC CURSOR DETECTION
     * =========================================================
     */

    private void updateMagneticCursor(
            MouseEvent event,
            Circle ring,
            Circle dot
    ) {

        Object target =
                event.getTarget();

        boolean clickable =
                false;

        if (
                target instanceof Node
        ) {

            Node node =
                    (Node) target;

            while (
                    node != null
            ) {

                if (
                        node instanceof Button
                ) {

                    clickable =
                            true;

                    break;
                }

                if (
                        node
                                .getStyleClass()
                                .contains(
                                        "drive-card"
                                )
                ) {

                    clickable =
                            true;

                    break;
                }

                node =
                        node.getParent();
            }
        }

        if (clickable) {

            ring.setRadius(
                    13
            );

            ring.setStrokeWidth(
                    1.5
            );

            dot.setRadius(
                    2.8
            );

        } else {

            ring.setRadius(
                    9
            );

            ring.setStrokeWidth(
                    1.25
            );

            dot.setRadius(
                    2.4
            );
        }
    }

    /*
     * =========================================================
     * MAIN
     * =========================================================
     */

    public static void main(
            String[] args
    ) {

        launch(args);
    }
}