                .add(
                        "bottom-bar"
                );

        bottomBar.setAlignment(
                Pos.CENTER_LEFT
        );

        Label pulse =
                new Label(
                        "●"
                );

        pulse
                .getStyleClass()
                .add(
                        "pulse"
                );

        Label status =
                new Label(
                        "SYSTEM READY"
                );

        status
                .getStyleClass()
                .add(
                        "footer-text"
                );

        javafx.scene.layout.Region spacer =
                new javafx.scene.layout.Region();

        HBox.setHgrow(
                spacer,
                Priority.ALWAYS
        );

        Label footer =
                new Label(
                        "MINION URE  •  READ-ONLY RECOVERY ENVIRONMENT"
                );

        footer
