                Pos.CENTER
        );

        /*
         * VERSION
         */
        HBox versionArea =
                new HBox(7);

        versionArea.setAlignment(
                Pos.CENTER
        );

        Label version =
                new Label(
                        "VERSION 0.1"
                );

        version
                .getStyleClass()
                .add(
                        "version"
                );

        Label beta =
                new Label(
                        "BETA"
                );

        beta
                .getStyleClass()
                .add(
                        "beta"
                );

        versionArea
                .getChildren()
                .addAll(
                        version,
                        beta
                );

        /*
         * LOGO
         */
        Label logo =
