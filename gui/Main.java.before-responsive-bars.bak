                );

        Label subtitle =
                new Label(
                        "UNIVERSAL RECOVERY ENGINE"
                );

        subtitle
                .getStyleClass()
                .add(
                        "subtitle"
                );

        /*
         * DIVIDER
         */
        javafx.scene.layout.Region divider =
