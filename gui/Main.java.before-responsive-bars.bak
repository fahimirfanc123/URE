package gui;

import javafx.application.Application;
import javafx.geometry.Pos;
import javafx.geometry.Rectangle2D;
import javafx.scene.Cursor;
import javafx.scene.Node;
import javafx.scene.Scene;
import javafx.scene.control.Button;
import javafx.scene.control.Label;
import javafx.scene.control.ScrollPane;
import javafx.scene.input.MouseEvent;
import javafx.scene.layout.BorderPane;
import javafx.scene.layout.HBox;
import javafx.scene.layout.Priority;
import javafx.scene.layout.StackPane;
import javafx.scene.layout.VBox;
import javafx.scene.paint.Color;
import javafx.scene.shape.Circle;
import javafx.stage.Screen;
import javafx.stage.Stage;
import javafx.stage.StageStyle;

import java.io.File;

public class Main extends Application {

    /*
     * =========================================================
     * WINDOW DRAGGING
     * =========================================================
     */

    private double dragOffsetX;
    private double dragOffsetY;

    /*
     * =========================================================
     * MANUAL MAXIMIZE STATE
     * =========================================================
     */

    private boolean maximized = false;

    private double restoreX;
    private double restoreY;
    private double restoreWidth;
    private double restoreHeight;

    /*
     * =========================================================
     * MAIN UI
     * =========================================================
     */

    private BorderPane layout;
    private VBox homePage;

    private Button maximizeButton;

    /*
     * MODULE 3:
     * Reference to the main application stage.
     */
    private Stage stageReference;

    @Override
    public void start(Stage stage) {

        /*
         * MODULE 3:
         * Save the application stage for GUI navigation.
         */
        stageReference = stage;

        /*
         * Undecorated window because MINION
         * has its own title bar.
         */
        stage.initStyle(StageStyle.UNDECORATED);

        stage.setTitle("MINION URE");

        /*
         * Root stack:
         *
         * layer 1 = application
         * layer 2 = magnetic cursor
         */
        StackPane root = new StackPane();

        layout = new BorderPane();

        layout
                .getStyleClass()
                .add("layout");

        /*
         * Create application sections.
         */
        HBox topBar =
                createTopBar(stage);

        homePage =
                createHomePage(stage);

        HBox bottomBar =
                createBottomBar();

        layout.setTop(topBar);

        layout.setCenter(homePage);

        layout.setBottom(bottomBar);

        root.getChildren().add(layout);

        /*
         * =====================================================
         * SCENE
         * =====================================================
         */

        Scene scene =
                new Scene(
                        root,
                        1100,
                        700
                );

        scene.setFill(
                Color.TRANSPARENT
        );

        scene.getStylesheets().add(

                getClass()
                        .getResource(
                                "/css/main.css"
                        )
                        .toExternalForm()
        );

        /*
         * Magnetic cursor.
         */
        createMagneticCursor(
                scene,
                root
        );

        stage.setScene(scene);

        /*
         * Minimum window size.
         */
        stage.setMinWidth(850);

        stage.setMinHeight(600);

        stage.show();
        stage.centerOnScreen();
    }

    /*
     * =========================================================
     * TOP BAR
     * =========================================================
     */

    private HBox createTopBar(
            Stage stage
    ) {

        HBox topBar =
        new HBox(12);

topBar
        .getStyleClass()
        .add("top-bar");

topBar.setAlignment(
        Pos.CENTER_LEFT
);

/*
 * Keep the custom title bar fixed and stable
 * when switching between application screens.
 */
topBar.setMinHeight(54);
topBar.setPrefHeight(54);
topBar.setMaxHeight(54);

topBar.setMinWidth(0);
topBar.setMaxWidth(Double.MAX_VALUE);

        

        /*
         * =====================================================
         * BRAND
         * =====================================================
         */

        HBox brandArea =
                new HBox(9);

        brandArea.setAlignment(
                Pos.CENTER_LEFT
        );

        Label miniLogo =
                new Label("M");

        miniLogo
                .getStyleClass()
                .add("mini-logo");

        VBox brandText =
                new VBox(-2);

        Label brand =
                new Label(
                        "MINION URE"
                );

        brand
                .getStyleClass()
                .add("brand");

        Label brandSubtitle =
                new Label(
                        "UNIVERSAL RECOVERY ENGINE"
                );

        brandSubtitle
                .getStyleClass()
                .add(
                        "brand-subtitle"
                );

        brandText
                .getChildren()
                .addAll(
                        brand,
                        brandSubtitle
                );

        brandArea
                .getChildren()
                .addAll(
                        miniLogo,
                        brandText
                );

        /*
         * =====================================================
         * SPACERS
         * =====================================================
         */

        javafx.scene.layout.Region leftSpacer =
                new javafx.scene.layout.Region();

        javafx.scene.layout.Region rightSpacer =
                new javafx.scene.layout.Region();

        HBox.setHgrow(
                leftSpacer,
                Priority.ALWAYS
        );

        HBox.setHgrow(
                rightSpacer,
                Priority.ALWAYS
        );

        /*
         * =====================================================
         * NAVIGATION
         * =====================================================
         */

        HBox navigation =
                new HBox(7);

        navigation.setAlignment(
                Pos.CENTER
        );

        Label navLabel =
                new Label(
                        "RECOVERY"
                );

        navLabel
                .getStyleClass()
                .add(
                        "nav-label"
                );

        Label navArrow =
                new Label("›");

        navArrow
                .getStyleClass()
                .add(
                        "nav-arrow"
                );

        navigation
                .getChildren()
                .addAll(
                        navLabel,
                        navArrow
                );

        /*
         * =====================================================
         * WINDOW CONTROLS
         * =====================================================
         */

        HBox windowControls =
                new HBox(3);

        windowControls.setAlignment(
                Pos.CENTER_RIGHT
        );

        Button minimizeButton =
                new Button("—");

        maximizeButton =
                new Button("□");

        Button closeButton =
                new Button("×");

        /*
         * CSS classes.
         */
        minimizeButton
                .getStyleClass()
                .addAll(
                        "window-button",
                        "minimize-button"
                );

        maximizeButton
                .getStyleClass()
                .addAll(
                        "window-button",
                        "maximize-button"
                );

        closeButton
                .getStyleClass()
                .addAll(
                        "window-button",
                        "close-button"
                );

        /*
         * Large hitboxes.
         */
        configureWindowButton(
                minimizeButton
        );

        configureWindowButton(
                maximizeButton
        );

        configureWindowButton(
                closeButton
        );

        /*
         * =====================================================
         * MINIMIZE
         * =====================================================
         */

        minimizeButton.setOnAction(
                event -> {

                    event.consume();

                    stage.setIconified(true);
                }
        );

        /*
         * =====================================================
         * MAXIMIZE
         * =====================================================
         */

        maximizeButton.setOnAction(
                event -> {

                    event.consume();

                    toggleManualMaximize(stage);
                }
        );

        /*
         * =====================================================
         * CLOSE
         * =====================================================
         */

        closeButton.setOnAction(
                event -> {

                    event.consume();

                    stage.close();
                }
        );

        windowControls
                .getChildren()
                .addAll(
                        minimizeButton,
                        maximizeButton,
                        closeButton
                );

        /*
         * Add everything.
         */
        topBar
                .getChildren()
                .addAll(
                        brandArea,
                        leftSpacer,
                        navigation,
                        rightSpacer,
                        windowControls
                );

        /*
         * =====================================================
         * WINDOW DRAGGING
         * =====================================================
         */

        topBar.addEventFilter(
                MouseEvent.MOUSE_PRESSED,
                event -> {

                    if (
                            isWindowControl(event)
                    ) {

                        return;
                    }

                    dragOffsetX =
                            event.getScreenX()
                                    - stage.getX();

                    dragOffsetY =
                            event.getScreenY()
                                    - stage.getY();
                }
        );

        topBar.addEventFilter(
                MouseEvent.MOUSE_DRAGGED,
                event -> {

                    if (
                            isWindowControl(event)
                    ) {

                        return;
                    }

                    /*
                     * Dragging a maximized window
                     * automatically restores it.
                     */
                    if (maximized) {

                        double mouseRatio =
                                event.getSceneX()
                                        /
                                        stage.getWidth();

                        restoreWindow(stage);

                        dragOffsetX =
                                stage.getWidth()
                                        *
                                        mouseRatio;

                        dragOffsetY = 18;
                    }

                    stage.setX(
                            event.getScreenX()
                                    - dragOffsetX
                    );

                    stage.setY(
                            event.getScreenY()
                                    - dragOffsetY
                    );
                }
        );

        /*
         * Double click title bar:
         *
         * maximize / restore.
         */
        topBar.setOnMouseClicked(
                event -> {

                    if (
                            event.getClickCount() == 2
                                    &&
                                    !isWindowControl(event)
                    ) {

                        toggleManualMaximize(
                                stage
                        );
                    }
                }
        );

        return topBar;
    }

    /*
     * =========================================================
     * WINDOW BUTTON SIZE
     * =========================================================
     */

    private void configureWindowButton(
            Button button
    ) {

        button.setMinSize(
                44,
                34
        );

        button.setPrefSize(
                44,
                34
        );

        button.setMaxSize(
                44,
                34
        );

        button.setFocusTraversable(
                false
        );
    }

    /*
     * =========================================================
     * CHECK WINDOW BUTTON
     * =========================================================
     */

    private boolean isWindowControl(
            MouseEvent event
    ) {

        if (
                !(event.getTarget()
                        instanceof Node)
        ) {

            return false;
        }

        Node node =
                (Node)
                        event.getTarget();

        while (
                node != null
        ) {

            if (
                    node instanceof Button
            ) {

                Button button =
                        (Button) node;

                if (
                        button
                                .getStyleClass()
                                .contains(
                                        "window-button"
                                )
                ) {

                    return true;
                }
            }

            node =
                    node.getParent();
        }

        return false;
    }

    /*
     * =========================================================
     * MANUAL MAXIMIZE
     * =========================================================
     */

    private void toggleManualMaximize(
            Stage stage
    ) {

        if (!maximized) {

            maximizeWindow(stage);

        } else {

            restoreWindow(stage);
        }
    }

    /*
     * =========================================================
     * MAXIMIZE WINDOW
     * =========================================================
     */

    private void maximizeWindow(
            Stage stage
    ) {

        restoreX =
                stage.getX();

        restoreY =
                stage.getY();

        restoreWidth =
                stage.getWidth();

        restoreHeight =
                stage.getHeight();

        Screen screen =
                getCurrentScreen(stage);

        Rectangle2D bounds =
                screen.getVisualBounds();

        stage.setX(
                bounds.getMinX()
        );

        stage.setY(
                bounds.getMinY()
        );

        stage.setWidth(
                bounds.getWidth()
        );

        stage.setHeight(
                bounds.getHeight()
        );

        maximized =
                true;

        maximizeButton.setText(
                "❐"
        );
    }

    /*
     * =========================================================
     * RESTORE WINDOW
     * =========================================================
     */

    private void restoreWindow(
            Stage stage
    ) {

        stage.setX(
                restoreX
        );

        stage.setY(
                restoreY
        );

        stage.setWidth(
                restoreWidth
        );

        stage.setHeight(
                restoreHeight
        );

        maximized =
                false;

        maximizeButton.setText(
                "□"
        );
    }

    /*
     * =========================================================
     * CURRENT SCREEN
     * =========================================================
     */

    private Screen getCurrentScreen(
            Stage stage
    ) {

        double centerX =
                stage.getX()
                        +
                        stage.getWidth() / 2;

        double centerY =
                stage.getY()
                        +
                        stage.getHeight() / 2;

        for (
                Screen screen :
                Screen.getScreens()
        ) {

            Rectangle2D bounds =
                    screen.getBounds();

            if (
                    bounds.contains(
                            centerX,
                            centerY
                    )
            ) {

                return screen;
            }
        }

        return Screen.getPrimary();
    }

    /*
     * =========================================================
     * HOME SCREEN
     * =========================================================
     */

